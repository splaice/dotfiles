<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.splaice.backup-code</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/splaice/.local/bin/tar-backup.sh</string>
        <string>/Users/splaice/Code</string>
        <string>/Users/splaice/Backups</string>
    </array>

    <key>StartInterval</key>
    <integer>3600</integer>

    <key>StandardOutPath</key>
    <string>/tmp/backup-code.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/backup-code.err</string>
</dict>
</plist>
